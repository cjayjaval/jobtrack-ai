# Copy this file to .env and fill in real values. Never commit .env.

# --- AI provider ---
# Currently only "openai" is implemented. Kept configurable so a future
# provider (e.g. "anthropic", "gemini") can be added without code changes here.
AI_PROVIDER=openai

# Your OpenAI API key. Keep this secret — server-side only, never in
# frontend code, localStorage, or the repository.
OPENAI_API_KEY=

# Defaults to gpt-5.4-mini if unset.
OPENAI_MODEL=gpt-5.4-mini

# --- Server ---
# Render provides PORT automatically in production; 3000 is used for local dev.
PORT=3000

# Comma-separated list of frontend origins allowed to call this API.
# Include both your local dev server and your deployed GitHub Pages URL.
ALLOWED_ORIGINS=http://localhost:5500,https://cjayjaval.github.io
